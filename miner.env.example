# Copy to miner.env (gitignored) for harness/run_miner.sh (pm2 app perturb26-miner).
WALLET_NAME=miner
WALLET_HOTKEY=default
NETUID=
NETWORK=finney
LOG_LEVEL=INFO
MINER_EXTRA_ARGS=

# Response image storage (read by upstream perturbnet.constants)
PERTURB_STORAGE_BACKEND=hippius      # hippius or r2
PERTURB_STORAGE_BUCKET=
PERTURB_STORAGE_ACCESS_KEY_ID=
PERTURB_STORAGE_SECRET_ACCESS_KEY=
PERTURB_STORAGE_ENDPOINT_URL=        # required for r2
PERTURB_STORAGE_REGION=

# Timing (seconds after the task boundary); see notes/timing.md
PERTURB26_SUBMIT_BY_SECONDS=34
PERTURB26_UPLOAD_RESERVE_SECONDS=5
# Optional AttackConfig overrides as JSON, e.g. {"safety_margin": 1.5}
PERTURB26_ATTACK_CONFIG=
