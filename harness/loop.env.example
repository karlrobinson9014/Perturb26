# Copy to harness/loop.env (gitignored) and edit.

# --- claude CLI
CLAUDE_BIN=claude
CLAUDE_MODEL=claude-opus-5-5
REVIEW_MODEL=claude-opus-5-5
# Headless sessions cannot answer permission prompts. Run the loop on a dedicated
# box/user; narrow this to --allowedTools if you prefer.
CLAUDE_FLAGS=--dangerously-skip-permissions
MAX_TURNS=150
ITER_TIMEOUT=5400     # seconds per agent iteration
REVIEW_TIMEOUT=5400
# ANTHROPIC_API_KEY=  # or authenticate once with `claude setup-token`

# --- loop policy
LOOP_MODE=auto        # auto (open [build] backlog items first) | build | research
MAX_ITERS=200
MAX_COST_USD=0        # 0 = no cap; otherwise stop once iterations.tsv spend exceeds it
ITER_SLEEP=30
TARGET_SCORE=0.993    # stop when both dev and holdout reach it (ceiling is 0.99303)

# --- benchmark / acceptance
BENCH_BUDGET=22       # seconds per image; matches the live deadline (notes/timing.md)
MIN_GAIN=0.002        # dev improvement needed to request a review
HOLDOUT_TOL=0.003     # holdout may not drop more than this vs the accepted best
HOLDOUT_DIR=$HOME/perturb26-holdout

# --- git
WORK_BRANCH=loop
MAIN_BRANCH=main
REMOTE=origin
PUSH=0                # 1 = push loop/main/tags to GitHub automatically
